# Copy to .env, fill in, then:  set -a; source .env; set +a
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional Webull OpenAPI (only if feed.provider: webull)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Phone push: install the free "ntfy" app, subscribe to a long random topic name
NTFY_TOPIC=
# Optional extra channels
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alpaca PAPER account keys (only for execution.mode: paper; from the Paper dashboard)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# Required in addition to execution.mode: live before ANY real order is sent
# KC_LIVE_TRADING=I_UNDERSTAND
# Optional: SEC 8-K filings in the news check. The SEC requires a contact, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=
