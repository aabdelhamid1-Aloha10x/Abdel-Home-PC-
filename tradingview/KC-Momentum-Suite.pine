//@version=5
// KC Momentum Suite — NTZ / ORB / VWAP / Auto-Levels + breakout-retest alerts
// Encodes the Kay Capitals (Sumesh) breakout-and-retest playbook:
//   NTZ = max(yesterday high, pre-market high) .. min(yesterday low, pre-market low)
//   ORB = first N minutes of the regular session
//   Entries = breakout of NTZ/ORB/VWAP on above-average volume, THEN a retest on lower volume
// Add this to each watchlist chart (SPY, QQQ, AMD, META, NVDA, TSLA, SPX). Requires
// "Extended Trading Hours" turned on in chart settings (Symbol > Session) and an
// accurate real-time/extended-hours data plan — Sumesh calls this out explicitly:
// delayed/free data draws NTZ and ORB lines in the wrong place.
indicator("KC Momentum Suite — NTZ/ORB/VWAP/Levels", overlay=true, max_boxes_count=20, max_lines_count=60, max_labels_count=200)

// ---------------- Session windows (America/New_York) ----------------
grpSession      = "Session Windows (America/New_York)"
tz              = "America/New_York"
preMktSession   = input.session("0400-0930:23456", "Pre-Market Session", group=grpSession)
orbSession      = input.session("0930-0945:23456", "Opening Range Window", group=grpSession)
firstNinety     = input.session("0930-1100:23456", "First 90-Min Hunting Window", group=grpSession)
powerHour       = input.session("1500-1600:23456", "Power Hour (Sumesh avoids new entries here)", group=grpSession)

grpLevels = "Levels"
showNTZ   = input.bool(true, "Show NTZ Box", group=grpLevels)
showORB   = input.bool(true, "Show ORB Lines", group=grpLevels)
showVWAP  = input.bool(true, "Show VWAP", group=grpLevels)
showSMA   = input.bool(true, "Show 200 SMA (chart TF + 60min)", group=grpLevels)
smaLen    = input.int(200, "SMA Length", group=grpLevels)

grpPivot      = "Auto Support/Resistance (approximation of manual levels — refine by eye pre-market)"
showPivots    = input.bool(true, "Show Auto Pivot Levels", group=grpPivot)
pivotLeft     = input.int(5, "Pivot Left Bars", group=grpPivot)
pivotRight    = input.int(5, "Pivot Right Bars", group=grpPivot)
maxPivots     = input.int(6, "Max Levels Per Side", group=grpPivot)

grpFilter      = "Breakout / Retest Filters"
volLen         = input.int(20, "Volume Average Length", group=grpFilter)
volMultiplier  = input.float(1.2, "Min Breakout Volume (x average)", step=0.1, group=grpFilter)
retestTolPct   = input.float(0.15, "Retest Proximity (% of price)", step=0.05, group=grpFilter)
armTimeoutBars = input.int(40, "Give Up Waiting For Retest After (bars)", group=grpFilter)

// ---------------- Day bookkeeping ----------------
newDay = ta.change(time("D"))

inPreMkt  = not na(time(timeframe.period, preMktSession, tz))
inORBWin  = not na(time(timeframe.period, orbSession, tz))
inFirst90 = not na(time(timeframe.period, firstNinety, tz))
inPowerHr = not na(time(timeframe.period, powerHour, tz))

// ---------------- Yesterday's high/low ----------------
[yHigh, yLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)

// ---------------- Pre-market high/low accumulation ----------------
var float pmHigh = na
var float pmLow  = na
if newDay
    pmHigh := na
    pmLow  := na
if inPreMkt
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow  := na(pmLow)  ? low  : math.min(pmLow, low)

// ---------------- ORB high/low accumulation ----------------
var float orbHigh = na
var float orbLow  = na
if newDay
    orbHigh := na
    orbLow  := na
if inORBWin
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)

// ---------------- NTZ (No Trading Zone) ----------------
ntzTop    = math.max(yHigh, nz(pmHigh, yHigh))
ntzBottom = math.min(yLow,  nz(pmLow,  yLow))

var box ntzBox = na
if showNTZ
    if newDay
        box.delete(ntzBox)
        ntzBox := box.new(bar_index, ntzTop, bar_index, ntzBottom, border_color=color.orange, bgcolor=color.new(color.orange, 88), extend=extend.right, border_width=1)
    else if not na(ntzBox)
        box.set_top(ntzBox, ntzTop)
        box.set_bottom(ntzBox, ntzBottom)

var line orbHiLine = na
var line orbLoLine = na
if showORB
    if newDay
        line.delete(orbHiLine)
        line.delete(orbLoLine)
        orbHiLine := line.new(bar_index, orbHigh, bar_index, orbHigh, extend=extend.right, color=color.blue, width=1)
        orbLoLine := line.new(bar_index, orbLow, bar_index, orbLow, extend=extend.right, color=color.blue, width=1)
    else if not na(orbHiLine)
        line.set_y1(orbHiLine, orbHigh)
        line.set_y2(orbHiLine, orbHigh)
        line.set_y1(orbLoLine, orbLow)
        line.set_y2(orbLoLine, orbLow)

// ---------------- VWAP (session-anchored, resets automatically each day) ----------------
vwapVal = ta.vwap(hlc3)
plot(showVWAP ? vwapVal : na, color=color.white, linewidth=2, title="VWAP")

// ---------------- 200 SMA confluence ----------------
sma200    = ta.sma(close, smaLen)
sma200_60 = request.security(syminfo.tickerid, "60", ta.sma(close, smaLen), lookahead=barmerge.lookahead_off)
plot(showSMA ? sma200 : na, color=color.yellow, title="200 SMA (chart TF)")
plot(showSMA ? sma200_60 : na, color=color.orange, linewidth=2, title="200 SMA (60min)")

// ---------------- Auto pivot S/R levels (recent reaction points) ----------------
var array<float> pivHighs     = array.new_float(0)
var array<float> pivLows      = array.new_float(0)
var array<line>  pivHighLines = array.new_line(0)
var array<line>  pivLowLines  = array.new_line(0)

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

if showPivots and not na(ph)
    array.unshift(pivHighs, ph)
    if array.size(pivHighs) > maxPivots
        array.pop(pivHighs)
    for i = 0 to array.size(pivHighLines) - 1
        line.delete(array.get(pivHighLines, i))
    array.clear(pivHighLines)
    for i = 0 to array.size(pivHighs) - 1
        lvl = array.get(pivHighs, i)
        array.push(pivHighLines, line.new(bar_index[pivotRight], lvl, bar_index, lvl, extend=extend.right, color=color.new(color.red, 40), style=line.style_dashed))

if showPivots and not na(pl)
    array.unshift(pivLows, pl)
    if array.size(pivLows) > maxPivots
        array.pop(pivLows)
    for i = 0 to array.size(pivLowLines) - 1
        line.delete(array.get(pivLowLines, i))
    array.clear(pivLowLines)
    for i = 0 to array.size(pivLows) - 1
        lvl = array.get(pivLows, i)
        array.push(pivLowLines, line.new(bar_index[pivotRight], lvl, bar_index, lvl, extend=extend.right, color=color.new(color.green, 40), style=line.style_dashed))

// ---------------- Breakout + retest state machines ----------------
volAvg = ta.sma(volume, volLen)

// -- NTZ Up (calls) --
var int   ntzUpState    = 0
var float ntzUpBreakVol = na
var int   ntzUpArmedBar = na
freshBreakNtzUp = close > ntzTop and close[1] <= ntzTop[1] and volume > volAvg * volMultiplier
if freshBreakNtzUp and ntzUpState == 0
    ntzUpState    := 1
    ntzUpBreakVol := volume
    ntzUpArmedBar := bar_index
ntzUpRetestOK = ntzUpState == 1 and low <= ntzTop * (1 + retestTolPct / 100) and close > ntzTop and volume < ntzUpBreakVol
if ntzUpRetestOK
    ntzUpState := 2
if ntzUpState == 1 and (bar_index - ntzUpArmedBar > armTimeoutBars or close < ntzBottom)
    ntzUpState := 0
if newDay
    ntzUpState := 0

// -- NTZ Down (puts) --
var int   ntzDnState    = 0
var float ntzDnBreakVol = na
var int   ntzDnArmedBar = na
freshBreakNtzDn = close < ntzBottom and close[1] >= ntzBottom[1] and volume > volAvg * volMultiplier
if freshBreakNtzDn and ntzDnState == 0
    ntzDnState    := 1
    ntzDnBreakVol := volume
    ntzDnArmedBar := bar_index
ntzDnRetestOK = ntzDnState == 1 and high >= ntzBottom * (1 - retestTolPct / 100) and close < ntzBottom and volume < ntzDnBreakVol
if ntzDnRetestOK
    ntzDnState := 2
if ntzDnState == 1 and (bar_index - ntzDnArmedBar > armTimeoutBars or close > ntzTop)
    ntzDnState := 0
if newDay
    ntzDnState := 0

// -- ORB Up (calls) --
var int   orbUpState    = 0
var float orbUpBreakVol = na
var int   orbUpArmedBar = na
freshBreakOrbUp = close > orbHigh and close[1] <= orbHigh[1] and volume > volAvg * volMultiplier
if freshBreakOrbUp and orbUpState == 0
    orbUpState    := 1
    orbUpBreakVol := volume
    orbUpArmedBar := bar_index
orbUpRetestOK = orbUpState == 1 and low <= orbHigh * (1 + retestTolPct / 100) and close > orbHigh and volume < orbUpBreakVol
if orbUpRetestOK
    orbUpState := 2
if orbUpState == 1 and (bar_index - orbUpArmedBar > armTimeoutBars or close < orbLow)
    orbUpState := 0
if newDay
    orbUpState := 0

// -- ORB Down (puts) --
var int   orbDnState    = 0
var float orbDnBreakVol = na
var int   orbDnArmedBar = na
freshBreakOrbDn = close < orbLow and close[1] >= orbLow[1] and volume > volAvg * volMultiplier
if freshBreakOrbDn and orbDnState == 0
    orbDnState    := 1
    orbDnBreakVol := volume
    orbDnArmedBar := bar_index
orbDnRetestOK = orbDnState == 1 and high >= orbLow * (1 - retestTolPct / 100) and close < orbLow and volume < orbDnBreakVol
if orbDnRetestOK
    orbDnState := 2
if orbDnState == 1 and (bar_index - orbDnArmedBar > armTimeoutBars or close > orbHigh)
    orbDnState := 0
if newDay
    orbDnState := 0

// -- "Advanced VWAP" reclaim + retest, both directions --
var int vwapUpState = 0
freshVwapUp = close > vwapVal and close[1] <= vwapVal[1]
if freshVwapUp and vwapUpState == 0
    vwapUpState := 1
vwapUpRetestOK = vwapUpState == 1 and low <= vwapVal and close > vwapVal
if vwapUpRetestOK
    vwapUpState := 2
if vwapUpState == 1 and close < vwapVal * (1 - retestTolPct / 100)
    vwapUpState := 0
if newDay
    vwapUpState := 0

var int vwapDnState = 0
freshVwapDn = close < vwapVal and close[1] >= vwapVal[1]
if freshVwapDn and vwapDnState == 0
    vwapDnState := 1
vwapDnRetestOK = vwapDnState == 1 and high >= vwapVal and close < vwapVal
if vwapDnRetestOK
    vwapDnState := 2
if vwapDnState == 1 and close > vwapVal * (1 + retestTolPct / 100)
    vwapDnState := 0
if newDay
    vwapDnState := 0

// ---------------- Approaching an auto S/R level (profit-take heads-up) ----------------
nearestLevel = float(na)
minDist = 1e10
if showPivots
    for i = 0 to array.size(pivHighs) - 1
        lvl = array.get(pivHighs, i)
        d = math.abs(close - lvl)
        if d < minDist
            minDist := d
            nearestLevel := lvl
    for i = 0 to array.size(pivLows) - 1
        lvl = array.get(pivLows, i)
        d = math.abs(close - lvl)
        if d < minDist
            minDist := d
            nearestLevel := lvl
approachingLevel = showPivots and not na(nearestLevel) and minDist <= close * (retestTolPct / 100)

// ---------------- Plots / labels ----------------
plotshape(freshBreakNtzUp, title="NTZ Break Up", style=shape.circle, location=location.belowbar, color=color.new(color.orange, 0), size=size.tiny)
plotshape(ntzUpRetestOK, title="NTZ Up Retest Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(freshBreakNtzDn, title="NTZ Break Down", style=shape.circle, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)
plotshape(ntzDnRetestOK, title="NTZ Down Retest Entry", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

plotshape(freshBreakOrbUp, title="ORB Break Up", style=shape.circle, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(orbUpRetestOK, title="ORB Up Retest Entry", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.small)
plotshape(freshBreakOrbDn, title="ORB Break Down", style=shape.circle, location=location.abovebar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(orbDnRetestOK, title="ORB Down Retest Entry", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.small)

plotshape(vwapUpRetestOK, title="VWAP Reclaim Retest Long", style=shape.diamond, location=location.belowbar, color=color.teal, size=size.small)
plotshape(vwapDnRetestOK, title="VWAP Reclaim Retest Short", style=shape.diamond, location=location.abovebar, color=color.maroon, size=size.small)

// ---------------- Session shading ----------------
bgcolor(inPreMkt ? color.new(color.gray, 92) : na, title="Pre-Market shading")
bgcolor(inFirst90 ? color.new(color.green, 93) : na, title="First 90-min hunting window")
bgcolor(inPowerHr ? color.new(color.red, 93) : na, title="Power hour caution")

// ---------------- Alerts ----------------
alertcondition(freshBreakNtzUp, title="NTZ Breakout Up (watch for retest)", message="{{ticker}}: broke ABOVE the NTZ on strong volume. Watch for a retest to confirm a CALL entry.")
alertcondition(ntzUpRetestOK, title="NTZ Retest Entry — LONG/CALLS", message="{{ticker}}: NTZ breakout-up retest confirmed on {{interval}}. Consider CALLS. Stop = other side of NTZ. Scale out at next levels, move stop to breakeven after first trim.")
alertcondition(freshBreakNtzDn, title="NTZ Breakout Down (watch for retest)", message="{{ticker}}: broke BELOW the NTZ on strong volume. Watch for a retest to confirm a PUT entry.")
alertcondition(ntzDnRetestOK, title="NTZ Retest Entry — SHORT/PUTS", message="{{ticker}}: NTZ breakout-down retest confirmed on {{interval}}. Consider PUTS. Stop = other side of NTZ. Scale out at next levels, move stop to breakeven after first trim.")

alertcondition(freshBreakOrbUp, title="ORB Breakout Up (watch for retest)", message="{{ticker}}: broke ABOVE the opening range on strong volume. Watch for a retest to confirm a CALL entry.")
alertcondition(orbUpRetestOK, title="ORB Retest Entry — LONG/CALLS", message="{{ticker}}: ORB breakout-up retest confirmed on {{interval}}. Consider CALLS. Stop = ORB low. Scale out at next levels.")
alertcondition(freshBreakOrbDn, title="ORB Breakout Down (watch for retest)", message="{{ticker}}: broke BELOW the opening range on strong volume. Watch for a retest to confirm a PUT entry.")
alertcondition(orbDnRetestOK, title="ORB Retest Entry — SHORT/PUTS", message="{{ticker}}: ORB breakout-down retest confirmed on {{interval}}. Consider PUTS. Stop = ORB high. Scale out at next levels.")

alertcondition(vwapUpRetestOK, title="VWAP Reclaim Retest — LONG", message="{{ticker}}: reclaimed VWAP and retested from above on {{interval}}. Consider CALLS.")
alertcondition(vwapDnRetestOK, title="VWAP Reclaim Retest — SHORT", message="{{ticker}}: lost VWAP and retested from below on {{interval}}. Consider PUTS.")

alertcondition(approachingLevel, title="Approaching Auto S/R Level (profit-take heads-up)", message="{{ticker}}: price is approaching an auto-marked level near {{close}} — consider trimming per your scale-out plan.")

// ---------------- Status dashboard ----------------
if barstate.islast
    var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)
    sessLabel = inPreMkt ? "Pre-Market" : inFirst90 ? "First 90 — HUNT" : inPowerHr ? "Power Hour — caution" : "Mid-day"
    inNTZ = close <= ntzTop and close >= ntzBottom
    table.cell(infoTable, 0, 0, "Session", text_color=color.white)
    table.cell(infoTable, 1, 0, sessLabel, text_color=color.yellow)
    table.cell(infoTable, 0, 1, "NTZ", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(ntzBottom, format.mintick) + " - " + str.tostring(ntzTop, format.mintick), text_color=color.orange)
    table.cell(infoTable, 0, 2, "ORB", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(orbLow, format.mintick) + " - " + str.tostring(orbHigh, format.mintick), text_color=color.blue)
    table.cell(infoTable, 0, 3, "VWAP", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(vwapVal, format.mintick), text_color=color.white)
    table.cell(infoTable, 0, 4, "In NTZ?", text_color=color.white)
    table.cell(infoTable, 1, 4, inNTZ ? "YES — no trade" : "no", text_color=inNTZ ? color.red : color.lime)
    table.cell(infoTable, 0, 5, "Nearest level", text_color=color.white)
    table.cell(infoTable, 1, 5, na(nearestLevel) ? "n/a" : str.tostring(nearestLevel, format.mintick), text_color=color.silver)
