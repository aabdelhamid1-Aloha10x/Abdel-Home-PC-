# Crewzero environment variables. NAMES ONLY. Never put real values in this file.
# Real values go in .env.local (git-ignored) for local dev, and in Cloudflare / Supabase / Trigger.dev secret stores for deploys.

# --- Setup only (prompt 00a). Revoke/rotate after setup. ---
OWNER_EMAIL=
HOSTINGER_API_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
AWS_SETUP_ACCESS_KEY_ID=
AWS_SETUP_SECRET_ACCESS_KEY=
MAX_PURCHASE_USD=400
PURCHASE_APPROVED=no

# --- App ---
APP_ENV=development                 # development | staging | production
APP_URL=                            # e.g. https://crewzero.ai
TENANT_PREVIEW_DOMAIN=              # e.g. crewzero.app

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in browser bundles
SUPABASE_DB_URL=                    # migrations only

# --- Models (via Cloudflare AI Gateway) ---
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=                # unified billing: one Cloudflare balance for supported providers
# Optional direct keys (BYOK through the same gateway, used when set):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Cloudflare ---
CF_API_TOKEN=                       # scoped: Workers, R2, DNS, Custom Hostnames
CF_ZONE_ID_PREVIEW=                 # zone for crewzero.app
CF_R2_BUCKET=

# --- Jobs ---
TRIGGER_SECRET_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# --- Stripe (Crewzero account) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Email (Amazon SES) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Domains (GoDaddy reseller API) ---
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENV=ote                     # ote (test) | production

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=                   # Crewzero business portfolio (Mode 1 ad accounts live here)
META_SYSTEM_USER_TOKEN=

# --- Google Ads (manager account) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=       # Crewzero sub-manager account id
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Later phases ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VAPI_API_KEY=
MODASH_API_KEY=
E2B_API_KEY=
