# Copy to .env ON THE WORKER HOST ONLY. Never commit, never paste in chat.
APP_URL=https://YOUR-APP-URL
BROWSER_WORKER_SECRET=            # same value as the app's BROWSER_WORKER_SECRET secret
WORKER_ID=worker-1
ACCOUNTS=<browser_search_accounts.id>=DATEXPERT_1   # comma list for more accounts
DATEXPERT_1_USERNAME=
DATEXPERT_1_PASSWORD=
# Optional
# DATEXPERT_LOGIN_URL=https://datexpert.app/login
# DATEXPERT_SEARCH_URL=               # set if the search form lives on a fixed page after login
# DATE_FORMAT=MM/DD/YYYY              # match what `npm run inspect` shows for the date fields
# POLL_MS=7000  MIN_GAP_MS=8000  JOB_TIMEOUT_MS=240000
